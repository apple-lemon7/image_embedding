<Window x:Class="ImageEmbedding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jina CLIP 画像類似検索" Width="1240" Height="820" MinWidth="900" MinHeight="600"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <Grid Background="#F4F6F8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#243447" Padding="16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Jina CLIP 画像類似検索" Foreground="White" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="フォルダまたは画像をドロップして登録できます" Foreground="#C9D4DF" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock x:Name="DeviceText" Text="推論エンジンを準備中…" Foreground="#C9D4DF" HorizontalAlignment="Right" />
          <TextBlock x:Name="CountText" Text="登録数: -" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,5,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="10" Padding="10" Background="White" CornerRadius="6" BorderBrush="#D6DCE2" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox x:Name="QueryBox" Grid.Row="0" FontSize="15" VerticalContentAlignment="Center"
                 ToolTip="日本語で検索文を入力" KeyDown="QueryBox_KeyDown" />
        <Button x:Name="SearchButton" Grid.Row="0" Grid.Column="1" Content="テキスト検索" Click="SearchButton_Click" Background="#2878C8" Foreground="White" />
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
          <Button x:Name="FolderButton" Content="フォルダを登録" Click="FolderButton_Click" />
          <Button x:Name="ImageButton" Content="画像を登録" Click="ImageButton_Click" />
          <Button x:Name="ImageSearchButton" Content="画像から検索" Click="ImageSearchButton_Click" />
          <Button Content="全件表示" Click="ShowAllButton_Click" />
          <Button x:Name="ExportButton" Content="検索結果を保存" Click="ExportButton_Click" IsEnabled="False" />
          <Button Content="選択画像の場所を開く" Click="OpenLocationButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <DataGrid x:Name="ResultsGrid" Grid.Row="2" Margin="10,0,10,8" AutoGenerateColumns="False"
              IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" RowHeight="116" MouseDoubleClick="ResultsGrid_MouseDoubleClick"
              SelectionChanged="ResultsGrid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="プレビュー" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Margin="4" Background="#ECEFF2">
                <Image Source="{Binding Thumbnail}" Width="136" Height="104" Stretch="Uniform" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="類似度" Binding="{Binding Similarity}" Width="90" />
        <DataGridTextColumn Header="画像ファイル名" Binding="{Binding FileName}" Width="220" />
        <DataGridTextColumn Header="画像サイズ" Binding="{Binding Size}" Width="110" />
        <DataGridTextColumn Header="画像の場所（フルパス）" Binding="{Binding FullPath}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="3" Background="White" BorderBrush="#D6DCE2" BorderThickness="1,1,0,0" Padding="10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ProgressBar x:Name="ProgressBar" Height="18" Minimum="0" Maximum="100" />
        <TextBlock x:Name="StatusText" Grid.Row="1" Text="起動中…" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
