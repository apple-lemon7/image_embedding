<Window x:Class="ImageEmbedding.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画像プレビュー" MinWidth="420" MinHeight="300" Background="#15171A"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Name="ImageViewport" Grid.Row="0" Margin="12,12,12,6" Background="#0C0D0F"
            ClipToBounds="True" PreviewMouseWheel="ImageViewport_PreviewMouseWheel"
            MouseLeftButtonDown="ImageViewport_MouseLeftButtonDown"
            MouseLeftButtonUp="ImageViewport_MouseLeftButtonUp"
            MouseMove="ImageViewport_MouseMove" MouseLeave="ImageViewport_MouseLeave">
      <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.RenderTransform>
          <MatrixTransform x:Name="ImageTransform" />
        </Image.RenderTransform>
      </Image>
    </Border>
    <Border Grid.Row="1" Background="#22262B" Padding="12,8">
      <Grid>
        <TextBlock x:Name="ResolutionText" Foreground="#E6EAF0" />
        <TextBlock x:Name="ZoomText" Foreground="#E6EAF0" HorizontalAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</Window>
